@page "/channels/{chatId:guid?}"
@attribute [Authorize]
<MudContainer MaxWidth="MaxWidth.False" Class="pa-0 full-height">
    <MudGrid Class="ma-0 full-height">

        <!-- MAIN CHAT -->
        <MudItem xs="12" md="9" Class="chat-layout">

            <!-- HEADER (STATIC) -->
            <MudPaper Elevation="0" Class="px-6 pt-0 pb-2 chat-header">
                @if (_isHeaderLoading)
                {
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                        <MudStack Spacing="1">
                            <MudSkeleton Height="32px" Width="240px" />
                            <MudSkeleton Height="20px" Width="360px" />
                        </MudStack>

                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <MudSkeleton Height="24px" Width="120px" />
                        </MudStack>
                    </MudStack>
                }
                else if (!string.IsNullOrWhiteSpace(_headerError))
                {
                    <MudAlert Severity="Severity.Error" Dense="true" Class="mb-2">
                        @_headerError
                    </MudAlert>

                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Error"
                               OnClick="RetryHeaderAsync">
                        Retry
                    </MudButton>
                }
                else
                {
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.h5" Class="fw-bold">
                                # @ChannelName
                            </MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                @ChannelDescription
                            </MudText>
                        </MudStack>

                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <MudIcon Icon="@Icons.Material.Filled.Groups" Color="Color.Primary" />
                            <MudText Typo="Typo.body2">@ParticipantsCount members</MudText>
                        </MudStack>
                    </MudStack>
                }
            </MudPaper>

            <!-- SCROLLABLE MESSAGES -->
            <div class="message-container" @ref="_messagesContainerRef">
                <div @ref="_messagesTopSentinelRef" class="observer-sentinel"></div>

                @if (_isMessagesLoading && Messages.Count == 0)
                {
                    <MudStack Spacing="3">
                        @for (var i = 0; i < 6; i++)
                        {
                            <div class="message-row">
                                <MudSkeleton Class="message-avatar-skeleton" />
                                <MudPaper Class="message-bubble" Elevation="0">
                                    <MudStack Spacing="1">
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                            <MudSkeleton Height="16px" Width="120px" />
                                            <MudSkeleton Height="14px" Width="60px" />
                                        </MudStack>
                                        <MudSkeleton Height="16px" Width="240px" />
                                        <MudSkeleton Height="16px" Width="180px" />
                                    </MudStack>
                                </MudPaper>
                            </div>
                        }
                    </MudStack>
                }
                else if (!string.IsNullOrWhiteSpace(_messagesError) && Messages.Count == 0)
                {
                    <MudPaper Class="pa-4">
                        <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">
                            @_messagesError
                        </MudAlert>

                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Error"
                                   OnClick="RetryMessagesAsync">
                            Retry messages
                        </MudButton>
                    </MudPaper>
                }
                else
                {
                    @if (!string.IsNullOrWhiteSpace(_messagesPagingError))
                    {
                        <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">
                            @_messagesPagingError
                            <MudButton Variant="Variant.Text"
                                       Color="Color.Warning"
                                       Class="ms-2"
                                       OnClick="RetryMessagesPagingAsync">
                                Retry
                            </MudButton>
                        </MudAlert>
                    }

                    <MudStack Spacing="3">
                        <Virtualize Items="@Messages"
                                    Context="message"
                                    OverscanCount="5">
                            <ItemContent>
                                <div class="@(message.IsMine ? "message-row mine" : "message-row")">
                                    <MudAvatar Size="Size.Medium" Class="message-avatar">
                                        @message.Initial
                                    </MudAvatar>

                                    <MudPaper Class="message-bubble" Elevation="0">
                                        <MudStack Spacing="1">
                                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                                <MudText Typo="Typo.subtitle2" Class="fw-bold">
                                                    @message.AuthorName
                                                </MudText>
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                    @FormatMessageTime(message.SentAt)
                                                </MudText>
                                            </MudStack>

                                            <MudText Typo="Typo.body2">
                                                @message.Content
                                            </MudText>
                                        </MudStack>
                                    </MudPaper>
                                </div>
                            </ItemContent>

                            <Placeholder>
                                <div class="message-row">
                                    <MudSkeleton Class="message-avatar-skeleton" />
                                    <MudPaper Class="message-bubble" Elevation="0">
                                        <MudStack Spacing="1">
                                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                                <MudSkeleton Height="16px" Width="120px" />
                                                <MudSkeleton Height="14px" Width="60px" />
                                            </MudStack>
                                            <MudSkeleton Height="16px" Width="200px" />
                                        </MudStack>
                                    </MudPaper>
                                </div>
                            </Placeholder>
                        </Virtualize>

                        @if (_isLoadingMoreMessages)
                        {
                            @for (var i = 0; i < 2; i++)
                            {
                                <div class="message-row">
                                    <MudSkeleton Class="message-avatar-skeleton" />
                                    <MudPaper Class="message-bubble" Elevation="0">
                                        <MudStack Spacing="1">
                                            <MudSkeleton Height="16px" Width="140px" />
                                            <MudSkeleton Height="16px" Width="220px" />
                                        </MudStack>
                                    </MudPaper>
                                </div>
                            }
                        }
                    </MudStack>
                }

                <div @ref="_messagesBottomAnchorRef"></div>
            </div>

            <MudPaper Elevation="0" Class="chat-composer pa-4">
                @if (!string.IsNullOrWhiteSpace(_sendMessageError))
                {
                    <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">
                        @_sendMessageError
                        <MudButton Variant="Variant.Text"
                                   Color="Color.Error"
                                   Class="ms-2"
                                   Disabled="@_isSendingMessage"
                                   OnClick="RetrySendMessageAsync">
                            Retry
                        </MudButton>
                    </MudAlert>
                }

                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.End">
                    <MudTextField T="string"
                                  @bind-Value="_messageText"
                                  Placeholder="Write a message..."
                                  Variant="Variant.Outlined"
                                  Lines="2"
                                  FullWidth="true"
                                  Disabled="@_isSendingMessage"
                                  Class="composer-input" />

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@(!_isSendingMessage ? Icons.Material.Filled.Send : null)"
                               Disabled="@(_isSendingMessage || !CanSendMessage)"
                               OnClick="SendMessageAsync">
                        @if (_isSendingMessage)
                        {
                            <MudProgressCircular Size="Size.Small"
                                                 Indeterminate="true"
                                                 Class="me-2" />
                            <span>Sending...</span>
                        }
                        else
                        {
                            <span>Send</span>
                        }
                    </MudButton>
                </MudStack>
            </MudPaper>

        </MudItem>

        <!-- SIDEBAR -->
        <MudItem md="3" Class="members-sidebar d-none d-md-flex">
            <div @ref="_membersContainerRef" class="members-panel-scroll-host">
                <MudPaper Elevation="0" Class="members-panel pa-4">
                    <MudText Typo="Typo.h6" Class="fw-bold mb-4">Members</MudText>

                    @if (_isMembersLoading && Members.Count == 0)
                    {
                        <MudStack Spacing="3">
                            @for (var i = 0; i < 8; i++)
                            {
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                    <MudSkeleton Class="member-avatar-skeleton" />
                                    <MudSkeleton Height="16px" Width="140px" />
                                </MudStack>
                            }
                        </MudStack>
                    }
                    else if (!string.IsNullOrWhiteSpace(_membersError) && Members.Count == 0)
                    {
                        <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">
                            @_membersError
                        </MudAlert>

                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Error"
                                   OnClick="RetryMembersAsync">
                            Retry members
                        </MudButton>
                    }
                    else
                    {
                        @if (!string.IsNullOrWhiteSpace(_membersPagingError))
                        {
                            <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">
                                @_membersPagingError
                                <MudButton Variant="Variant.Text"
                                           Color="Color.Warning"
                                           Class="ms-2"
                                           OnClick="RetryMembersPagingAsync">
                                    Retry
                                </MudButton>
                            </MudAlert>
                        }

                        <MudStack Spacing="3">
                            <Virtualize Items="@Members"
                                        Context="member"
                                        OverscanCount="5">
                                <ItemContent>
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                        <MudAvatar Size="Size.Small" Class="member-avatar">
                                            @member.Initial
                                        </MudAvatar>

                                        <MudText Typo="Typo.body2">@member.DisplayName</MudText>
                                    </MudStack>
                                </ItemContent>

                                <Placeholder>
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                        <MudSkeleton Class="member-avatar-skeleton" />
                                        <MudSkeleton Height="16px" Width="140px" />
                                    </MudStack>
                                </Placeholder>
                            </Virtualize>

                            @if (_isLoadingMoreMembers)
                            {
                                @for (var i = 0; i < 3; i++)
                                {
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                        <MudSkeleton Class="member-avatar-skeleton" />
                                        <MudSkeleton Height="16px" Width="140px" />
                                    </MudStack>
                                }
                            }

                            <div @ref="_membersBottomSentinelRef" class="observer-sentinel"></div>
                        </MudStack>
                    }
                </MudPaper>
            </div>
        </MudItem>

    </MudGrid>
</MudContainer>

<style>
    .full-height {
        height: 100vh;
    }

    .chat-layout {
        display: flex;
        flex-direction: column;
        height: 100vh;
        overflow: hidden;
    }

    .chat-header {
        flex-shrink: 0;
    }

    .message-container {
        flex: 1;
        overflow-y: auto;
        padding: 16px;
        padding-bottom: 200px;
    }

    .chat-composer {
        flex-shrink: 0;
        border-top: 1px solid #e0e0e0;
        background: white;
        position: fixed;
        bottom: 0;
        left: 300px;
        right: 0;
        z-index: 1100;
    }

    .message-row {
        display: flex;
        gap: 12px;
    }

        .message-row.mine {
            flex-direction: row-reverse;
        }

    .message-bubble {
        padding: 12px;
        max-width: 600px;
        border-radius: 12px;
        background-color: #f5f5f5;
    }

    .message-row.mine .message-bubble {
        background-color: #d1e7ff;
    }

    .members-sidebar {
        height: 100vh;
    }

    .members-panel-scroll-host {
        width: 100%;
        height: 100vh;
        overflow-y: auto;
    }

    .members-panel {
        width: 100%;
        min-height: 100vh;
    }

    .observer-sentinel {
        width: 100%;
        height: 1px;
    }

    .message-avatar-skeleton {
        width: 40px;
        min-width: 40px;
        height: 40px;
        border-radius: 50%;
    }

    .member-avatar-skeleton {
        width: 32px;
        min-width: 32px;
        height: 32px;
        border-radius: 50%;
    }

    .message-avatar,
    .member-avatar {
        flex-shrink: 0;
    }
</style>
