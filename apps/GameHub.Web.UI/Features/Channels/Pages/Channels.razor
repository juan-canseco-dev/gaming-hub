@page "/home"
@attribute [Authorize]

<MudContainer MaxWidth="MaxWidth.False" Class="pa-6 home-page">
    <MudStack Spacing="4">

        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
            <div>
                @if (IsLoading)
                {
                    <MudSkeleton Height="32px" Width="220px" />
                    <MudSkeleton Height="18px" Width="300px" Class="mt-2" />
                }
                else
                {
                    <MudText Typo="Typo.h4" Class="fw-bold">Join a Chat Room</MudText>
                    <MudText Typo="Typo.body1" Color="Color.Secondary">
                        Explore channels and join the conversations that match your interests.
                    </MudText>
                }
            </div>

            <MudPaper Class="pa-3 stats-chip" Elevation="0">
                @if (IsLoading)
                {
                    <MudSkeleton Height="14px" Width="100px" />
                    <MudSkeleton Height="24px" Width="40px" Class="mt-2" />
                }
                else
                {
                    <MudText Typo="Typo.subtitle2">Available Rooms</MudText>
                    <MudText Typo="Typo.h6">@ChannelList.Count</MudText>
                }
            </MudPaper>
        </MudStack>

        @if (IsLoading)
        {
            <MudGrid Spacing="3">
                @for (int i = 0; i < 6; i++)
                {
                    <MudItem xs="12" sm="6" md="6" lg="4" xl="3">
                        <MudCard Class="h-100 pa-4">
                            <MudSkeleton Height="20px" Width="60%" />
                            <MudSkeleton Height="14px" Width="40%" Class="mt-2" />
                            <MudSkeleton Height="60px" Class="mt-4" />
                            <MudSkeleton Height="20px" Width="50%" Class="mt-4" />
                            <MudSkeleton Height="36px" Class="mt-6" />
                        </MudCard>
                    </MudItem>
                }
            </MudGrid>
        }
        else
        {
            <MudGrid Spacing="3">
                @foreach (var channel in ChannelList)
                {
                    <MudItem xs="12" sm="6" md="6" lg="4" xl="3">
                        <MudCard Class="channel-card h-100">
                            <MudCardContent>
                                <MudStack Spacing="2">
                                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start">
                                        <div>
                                            <MudText Typo="Typo.h6" Class="fw-bold">
                                                #@channel.Slug
                                            </MudText>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                Chat Room
                                            </MudText>
                                        </div>

                                        <MudAvatar Size="Size.Medium" Class="channel-avatar">
                                            <MudIcon Icon="@Icons.Material.Filled.Forum" />
                                        </MudAvatar>
                                    </MudStack>

                                    <MudText Typo="Typo.body2" Class="channel-description">
                                        @channel.Description
                                    </MudText>

                                    <MudDivider Class="my-2" />

                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                        <MudIcon Icon="@Icons.Material.Filled.Groups" Size="Size.Small" Color="Color.Primary" />
                                        <MudText Typo="Typo.body2">
                                            <strong>@channel.ParticipantsCount</strong> participants
                                        </MudText>
                                    </MudStack>
                                </MudStack>
                            </MudCardContent>

                            <MudCardActions Class="px-4 pb-4 pt-0">
                                @if (IsJoining(channel.ChatId))
                                {
                                    <MudButton Variant="Variant.Filled"
                                               Color="Color.Primary"
                                               FullWidth="true"
                                               Loading="@IsJoining(channel.ChatId)">
    
                                        <MudProgressCircular 
                                            Style="color: white;"
                                            Class="ms-n1" 
                                            Size="Size.Small" 
                                            Indeterminate="true" />

                                    </MudButton>
                                }
                                else
                                {
                                    <MudButton Variant="Variant.Filled"
                                               Color="Color.Primary"
                                               FullWidth="true"
                                               StartIcon="@Icons.Material.Filled.Login"
                                               OnClick="@(() => HandleChannelAction(channel))">

                                        @(channel.IsJoined ? "Go to Room" : "Join Room")
                                            
                                    </MudButton>
                                }
                            
                            </MudCardActions>
                        </MudCard>
                    </MudItem>
                }
            </MudGrid>
        }
    </MudStack>
</MudContainer>