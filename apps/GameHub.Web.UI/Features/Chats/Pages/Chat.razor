@page "/chats/{chatId:guid?}"
@page "/channels/{chatId:guid?}"
@attribute [Authorize]

<MudContainer MaxWidth="MaxWidth.False" Class="pa-0 channels-page">
    <MudGrid Class="ma-0 channels-grid">

        <!-- MAIN CHAT -->
        <MudItem xs="12" md="9" Class="chat-layout">

            <!-- HEADER -->
            <MudPaper Elevation="0" Class="px-6 pt-4 pb-3 chat-header">
                @if (_isHeaderLoading)
                {
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                        <MudStack Spacing="1">
                            <MudSkeleton Height="32px" Width="240px" />
                            <MudSkeleton Height="20px" Width="360px" />
                        </MudStack>

                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <MudSkeleton Height="24px" Width="120px" />
                        </MudStack>
                    </MudStack>
                }
                else if (!string.IsNullOrWhiteSpace(_headerError))
                {
                    <div class="section-error-host">
                        <MudStack Spacing="2" AlignItems="AlignItems.Center" Justify="Justify.Center" Class="section-error-content">
                            <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Size="Size.Large" Color="Color.Error" />
                            <MudText Typo="Typo.h6">Unable to load chat details</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center">
                                @_headerError
                            </MudText>
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Error"
                                       OnClick="RetryHeaderAsync">
                                Retry
                            </MudButton>
                        </MudStack>
                    </div>
                }
                else
                {
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.h5" Class="fw-bold">
                                # @ChatTitle
                            </MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                @ChatDescription
                            </MudText>
                        </MudStack>

                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <span class="presence-summary-dot"></span>
                            <MudText Typo="Typo.body2">@OnlineUsersCount online</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">· @ParticipantsCount members</MudText>
                        </MudStack>
                    </MudStack>
                }
            </MudPaper>

            <!-- MESSAGES -->
            <div class="message-region">
                <div class="message-container" @ref="_messagesContainerRef">
                    <div @ref="_messagesTopSentinelRef" class="observer-sentinel"></div>

                @if (_isMessagesLoading && Messages.Count == 0)
                {
                    <MudStack Spacing="3" Class="messages-stack">
                        @for (var i = 0; i < 6; i++)
                        {
                            <div class="message-row">
                                <MudSkeleton Class="message-avatar-skeleton" />
                                <MudPaper Class="message-bubble" Elevation="0">
                                    <MudStack Spacing="1">
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                            <MudSkeleton Height="16px" Width="120px" />
                                            <MudSkeleton Height="14px" Width="60px" />
                                        </MudStack>
                                        <MudSkeleton Height="16px" Width="240px" />
                                        <MudSkeleton Height="16px" Width="180px" />
                                    </MudStack>
                                </MudPaper>
                            </div>
                        }
                    </MudStack>
                }
                else if (!string.IsNullOrWhiteSpace(_messagesError) && Messages.Count == 0)
                {
                    <div class="section-error-host section-error-host-messages">
                        <MudStack Spacing="2" AlignItems="AlignItems.Center" Justify="Justify.Center" Class="section-error-content">
                            <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Size="Size.Large" Color="Color.Error" />
                            <MudText Typo="Typo.h6">Unable to load messages</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center">
                                @_messagesError
                            </MudText>
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Error"
                                       OnClick="RetryMessagesAsync">
                                Retry messages
                            </MudButton>
                        </MudStack>
                    </div>
                }
                else
                {
                    @if (!string.IsNullOrWhiteSpace(_messagesPagingError))
                    {
                        <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">
                            @_messagesPagingError
                            <MudButton Variant="Variant.Text"
                                       Color="Color.Warning"
                                       Class="ms-2"
                                       OnClick="RetryMessagesPagingAsync">
                                Retry
                            </MudButton>
                        </MudAlert>
                    }

                    <MudStack Spacing="3" Class="messages-stack">
                        <Virtualize Items="@Messages"
                                    Context="message"
                                    OverscanCount="5">
                            <ItemContent>
                                <div class="@(message.IsMine ? "message-row mine" : "message-row")">
                                    <MudAvatar Size="Size.Medium" Class="message-avatar" Color="@message.AvatarColor">
                                        @message.Initial
                                    </MudAvatar>

                                    <MudPaper Class="message-bubble" Elevation="0">
                                        <MudStack Spacing="1">
                                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                                <MudText Typo="Typo.subtitle2" Class="fw-bold">
                                                    @message.AuthorName
                                                </MudText>

                                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                    @DateFormatter.ToChatFormat(message.SentAt)
                                                </MudText>
                                            </MudStack>

                                            <MudText Typo="Typo.body2">
                                                @message.Content
                                            </MudText>
                                        </MudStack>
                                    </MudPaper>
                                </div>
                            </ItemContent>

                            <Placeholder>
                                <div class="message-row">
                                    <MudSkeleton Class="message-avatar-skeleton" />
                                    <MudPaper Class="message-bubble" Elevation="0">
                                        <MudStack Spacing="1">
                                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                                <MudSkeleton Height="16px" Width="120px" />
                                                <MudSkeleton Height="14px" Width="60px" />
                                            </MudStack>
                                            <MudSkeleton Height="16px" Width="200px" />
                                        </MudStack>
                                    </MudPaper>
                                </div>
                            </Placeholder>
                        </Virtualize>

                        @if (_isLoadingMoreMessages)
                        {
                            @for (var i = 0; i < 2; i++)
                            {
                                <div class="message-row">
                                    <MudSkeleton Class="message-avatar-skeleton" />
                                    <MudPaper Class="message-bubble" Elevation="0">
                                        <MudStack Spacing="1">
                                            <MudSkeleton Height="16px" Width="140px" />
                                            <MudSkeleton Height="16px" Width="220px" />
                                        </MudStack>
                                    </MudPaper>
                                </div>
                            }
                        }
                    </MudStack>
                }

                    <div class="observer-sentinel"></div>
                </div>

                @if (_newMessagesCount > 0)
                {
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.KeyboardArrowDown"
                               OnClick="ScrollToNewMessagesAsync"
                               Class="new-messages-indicator"
                               aria-live="polite">
                        @NewMessagesLabel
                    </MudButton>
                }
            </div>

            <!-- COMPOSER -->
            <MudPaper Elevation="0" Class="chat-composer px-6 py-3">
                @if (!string.IsNullOrWhiteSpace(_sendMessageError))
                {
                    <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">
                        @_sendMessageError
                        <MudButton Variant="Variant.Text"
                                   Color="Color.Error"
                                   Class="ms-2"
                                   OnClick="RetrySendMessageAsync">
                            Retry
                        </MudButton>
                    </MudAlert>
                }

                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.End" Class="composer-row">
                    <MudTextField T="string"
                                  @ref="_messageTextField"
                                  @bind-Value="_messageText"
                                  Placeholder="Write a message..."
                                  Variant="Variant.Outlined"
                                  Lines="1"
                                  Margin="Margin.Dense"
                                  FullWidth="true"
                                  Disabled="@_isSendingMessage"
                                  Class="composer-input"
                                  Immediate="true"
                                  OnKeyDown="HandleKeyDown"
                                  />

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               OnClick="SendMessageAsync"
                               Disabled="@(_isSendingMessage || string.IsNullOrWhiteSpace(_messageText))"
                               Class="composer-send-button"
                               aria-label="Send message"
                               title="Send message">
                        @if (_isSendingMessage)
                        {
                            <MudProgressCircular Style="color: white;"
                                                 Size="Size.Small"
                                                 Indeterminate="true" />
                        }
                        else
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Send" Size="Size.Medium" />
                        }
                    </MudButton>
                </MudStack>
            </MudPaper>

        </MudItem>

        <!-- SIDEBAR -->
        <MudItem md="3" Class="members-sidebar d-none d-md-flex">
            <MudPaper Elevation="0" Class="members-panel">

                <div class="members-header pa-4">
                    @if (_isMembersLoading && string.IsNullOrWhiteSpace(_membersError))
                    {
                        <MudStack Spacing="1">
                            <MudSkeleton Height="24px" Width="110px" />
                            <MudSkeleton Height="16px" Width="140px" />
                        </MudStack>
                    }
                    else
                    {
                        <MudText Typo="Typo.h6" Class="fw-bold">Members</MudText>
                    }
                </div>

                <div @ref="_membersContainerRef" class="members-list-scroll-host">
                    @if (_isMembersLoading && Members.Count == 0)
                    {
                        <MudStack Spacing="3" Class="pa-4 members-list-content">
                            @for (var i = 0; i < 8; i++)
                            {
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                    <MudSkeleton Class="member-avatar-skeleton" />
                                    <MudSkeleton Height="16px" Width="140px" />
                                </MudStack>
                            }
                        </MudStack>
                    }
                    else if (!string.IsNullOrWhiteSpace(_membersError) && Members.Count == 0)
                    {
                        <div class="section-error-host section-error-host-members">
                            <MudStack Spacing="2" AlignItems="AlignItems.Center" Justify="Justify.Center" Class="section-error-content">
                                <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Size="Size.Large" Color="Color.Error" />
                                <MudText Typo="Typo.h6">Unable to load members</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center">
                                    @_membersError
                                </MudText>
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Error"
                                           OnClick="RetryMembersAsync">
                                    Retry members
                                </MudButton>
                            </MudStack>
                        </div>
                    }
                    else
                    {
                        <MudStack Spacing="3" Class="pa-4 members-list-content">
                            @if (!string.IsNullOrWhiteSpace(_membersPagingError))
                            {
                                <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">
                                    @_membersPagingError
                                    <MudButton Variant="Variant.Text"
                                               Color="Color.Warning"
                                               Class="ms-2"
                                               OnClick="RetryMembersPagingAsync">
                                        Retry
                                    </MudButton>
                                </MudAlert>
                            }

                            <Virtualize Items="@Members"
                                        Context="member"
                                        OverscanCount="5">
                                <ItemContent>
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="member-row">
                                        <div class="member-avatar-presence">
                                            <MudAvatar Size="Size.Small" Class="member-avatar" Color="@member.AvatarColor">
                                                @member.Initial
                                            </MudAvatar>
                                            <span class="presence-dot @GetPresenceCssClass(member)"></span>
                                        </div>

                                        <MudStack Spacing="0">
                                            <MudText Typo="Typo.body2">@member.DisplayName</MudText>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                @member.PresenceStatus
                                            </MudText>
                                        </MudStack>
                                    </MudStack>
                                </ItemContent>

                                <Placeholder>
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="member-row">
                                        <MudSkeleton Class="member-avatar-skeleton" />
                                        <MudSkeleton Height="16px" Width="140px" />
                                    </MudStack>
                                </Placeholder>
                            </Virtualize>

                            @if (_isLoadingMoreMembers)
                            {
                                @for (var i = 0; i < 3; i++)
                                {
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                        <MudSkeleton Class="member-avatar-skeleton" />
                                        <MudSkeleton Height="16px" Width="140px" />
                                    </MudStack>
                                }
                            }

                            <div @ref="_membersBottomSentinelRef" class="observer-sentinel"></div>
                        </MudStack>
                    }
                </div>

            </MudPaper>
        </MudItem>
    </MudGrid>
</MudContainer>

<style>
    .channels-page {
        height: 100%;
    }

    .channels-grid {
        height: 100%;
        min-height: 0;
        overflow: hidden;
    }

    .chat-layout {
        display: flex;
        flex-direction: column;
        height: 100%;
        min-height: 0;
        overflow: hidden;
        background: white;
    }

    .chat-header {
        position: sticky;
        top: 0;
        z-index: 2;
        display: flex;
        align-items: center;
        flex-shrink: 0;
        min-height: 88px;
        background: white;
        border-bottom: 1px solid #e0e0e0;
    }

    .chat-header > * {
        width: 100%;
    }

    .presence-summary-dot {
        width: 9px;
        height: 9px;
        border-radius: 50%;
        background: #2e7d32;
        display: inline-block;
    }

    .member-avatar-presence {
        position: relative;
        display: inline-flex;
        flex: 0 0 auto;
    }

    .presence-dot {
        position: absolute;
        right: -1px;
        bottom: -1px;
        width: 10px;
        height: 10px;
        border: 2px solid white;
        border-radius: 50%;
        background: #9e9e9e;
    }

    .presence-dot.online {
        background: #2e7d32;
    }

    .presence-dot.away {
        background: #ed6c02;
    }

    .message-container {
        flex: 1 1 auto;
        height: 100%;
        min-height: 0;
        overflow-y: auto;
        overflow-x: hidden;
        padding: 20px 24px;
        overscroll-behavior: contain;
    }

    .message-region {
        position: relative;
        display: flex;
        flex: 1 1 auto;
        min-height: 0;
    }

    .new-messages-indicator {
        position: absolute;
        left: 50%;
        bottom: 16px;
        z-index: 3;
        transform: translateX(-50%);
        border-radius: 999px;
        box-shadow: 0 4px 14px rgba(0, 0, 0, 0.22);
        white-space: nowrap;
    }

    .messages-stack {
        min-height: min-content;
        width: 100%;
    }

    .chat-composer {
        position: sticky;
        bottom: 0;
        z-index: 2;
        flex-shrink: 0;
        background: white;
        border-top: 1px solid #e0e0e0;
    }

    .composer-row {
        width: 100%;
    }

    .composer-input {
        background: white;
    }

    .composer-input .mud-input-outlined,
    .composer-input .mud-input-outlined-border {
        border-radius: 24px;
    }

    .composer-input .mud-input-outlined {
        background: #f5f6f8;
    }

    .composer-input textarea {
        padding-top: 11px !important;
        padding-bottom: 11px !important;
    }

    .composer-send-button {
        align-self: flex-end;
        flex: 0 0 48px;
        width: 48px;
        min-width: 48px;
        height: 48px;
        min-height: 48px;
        padding: 0;
        border-radius: 50%;
    }

    .message-row {
        display: flex;
        width: 100%;
        gap: 12px;
        align-items: flex-start;
    }

        .message-row.mine {
            flex-direction: row-reverse;
            justify-content: flex-start;
        }

    .message-bubble {
        padding: 12px;
        width: fit-content;
        max-width: min(640px, 72%);
        border-radius: 14px 14px 14px 4px;
        background-color: #f5f5f5;
        word-break: break-word;
    }

    .message-row.mine .message-bubble {
        background-color: #d1e7ff;
        border-radius: 14px 14px 4px 14px;
    }

    .members-sidebar {
        height: 100%;
        min-height: 0;
        overflow: hidden;
    }

    .members-panel {
        width: 100%;
        height: 100%;
        max-height: 100%;
        min-height: 0;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        background: white;
        border-left: 1px solid #e0e0e0;
    }

    .members-header {
        position: sticky;
        top: 0;
        z-index: 2;
        flex-shrink: 0;
        background: white;
        border-bottom: 1px solid #e0e0e0;
        min-height: 88px;
        display: flex;
        align-items: center;
    }

    .members-list-scroll-host {
        flex: 1 1 auto;
        height: 0;
        min-height: 0;
        overflow-y: scroll;
        overflow-x: auto;
        scrollbar-gutter: stable;
        scrollbar-width: thin;
        overscroll-behavior: contain;
    }

    .members-list-scroll-host::-webkit-scrollbar {
        width: 8px;
        height: 8px;
    }

    .members-list-scroll-host::-webkit-scrollbar-thumb {
        background: rgba(90, 90, 90, 0.38);
        border: 2px solid transparent;
        border-radius: 999px;
        background-clip: padding-box;
    }

    .members-list-scroll-host::-webkit-scrollbar-track {
        background: transparent;
    }

    .members-list-content {
        width: max-content;
        min-width: 100%;
    }

    .member-row {
        min-width: max-content;
    }

    .member-row .mud-typography {
        white-space: nowrap;
    }

    .observer-sentinel {
        width: 100%;
        height: 1px;
        flex-shrink: 0;
    }

    .message-avatar-skeleton {
        width: 40px;
        min-width: 40px;
        height: 40px;
        border-radius: 50%;
    }

    .member-avatar-skeleton {
        width: 32px;
        min-width: 32px;
        height: 32px;
        border-radius: 50%;
    }

    .message-avatar,
    .member-avatar {
        flex-shrink: 0;
    }

    .section-error-host {
        min-height: 180px;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px;
    }

    .section-error-host-messages {
        min-height: 320px;
    }

    .section-error-host-members {
        min-height: 260px;
    }

    .section-error-content {
        width: 100%;
        max-width: 420px;
        text-align: center;
    }

    @@media (max-width: 959.98px) {
        .message-container {
            padding: 12px 16px;
        }

        .chat-header {
            padding-left: 16px !important;
            padding-right: 16px !important;
        }

        .chat-composer {
            padding: 12px 16px !important;
        }

        .message-bubble {
            max-width: calc(100% - 64px);
        }
    }
</style>
