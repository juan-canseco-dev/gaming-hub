@page "/channels"
@attribute [Authorize]
@inject NavigationManager NavigationManager

<MudContainer MaxWidth="MaxWidth.False" Class="pa-6 channels-page">
    <MudStack Spacing="3">
        <div>
            <MudText Typo="Typo.h4" Class="fw-bold">My Channels</MudText>
            <MudText Typo="Typo.body1" Color="Color.Secondary">
                Jump back into your active gaming conversations.
            </MudText>
        </div>

        <MudPaper Class="channels-list pa-2" Elevation="0">
            <MudList T="MyChannelListItemDto" Class="pa-0">
                @foreach (var channel in ChannelsList)
                {
                    <MudListItem Class="channel-item"
                                 OnClick="@(() => OpenChannel(channel))">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="w-100">

                            <!-- Avatar -->
                            <MudAvatar Size="Size.Large" Class="channel-avatar">
                                @GetInitials(channel.Name)
                            </MudAvatar>

                            <!-- Main content -->
                            <div class="flex-grow-1 min-width-0">
                                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" Class="w-100">
                                    <MudText Typo="Typo.subtitle1" Class="fw-bold text-truncate">
                                        @channel.Name
                                    </MudText>

                                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="channel-time">
                                        @FormatTime(channel.LastMessageAt)
                                    </MudText>
                                </MudStack>

                                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="w-100 mt-1">
                                    <div class="channel-preview-wrapper">
                                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="text-truncate">
                                            @(string.IsNullOrWhiteSpace(channel.LastMessagePreview)
                                                ? "No messages yet"
                                                : channel.LastMessagePreview)
                                        </MudText>

                                        <MudText Typo="Typo.caption" Class="mt-1 participants-text">
                                            @channel.ParticipantsCount participants
                                        </MudText>
                                    </div>

                                    <MudStack AlignItems="AlignItems.End" Spacing="1">
                                        @if (channel.UnreadCount > 0)
                                        {
                                            <MudBadge Content="@channel.UnreadCount"
                                                      Color="Color.Primary"
                                                      Class="unread-badge" />
                                        }
                                    </MudStack>
                                </MudStack>
                            </div>
                        </MudStack>
                    </MudListItem>

                    <MudDivider />
                }
            </MudList>
        </MudPaper>
    </MudStack>
</MudContainer>

@code {
    private List<MyChannelListItemDto> ChannelsList = new()
    {
        new(
            1,
            Guid.NewGuid(),
            "general-gaming",
            "General Gaming",
            "Talk about what you're currently playing and gaming news.",
            128,
            "Anyone playing Helldivers 2 tonight?",
            DateTimeOffset.Now.AddMinutes(-10),
            3),

        new(
            2,
            Guid.NewGuid(),
            "retro-gaming",
            "Retro Gaming",
            "Classic consoles, arcade games and nostalgia.",
            54,
            "I still think the SNES had the best RPG era.",
            DateTimeOffset.Now.AddHours(-1),
            0),

        new(
            3,
            Guid.NewGuid(),
            "rpg-story",
            "RPG & Story",
            "Story-driven games, lore and character builds.",
            87,
            "The Witcher 3 side quests are still unmatched.",
            DateTimeOffset.Now.AddMinutes(-35),
            7),

        new(
            4,
            Guid.NewGuid(),
            "competitive",
            "Competitive Play",
            "Ranked strategies, esports and multiplayer.",
            201,
            "We need one more for ranked tonight.",
            DateTimeOffset.Now.AddDays(-1),
            1),

        new(
            5,
            Guid.NewGuid(),
            "indie-creative",
            "Indie & Creative",
            "Indie games, cozy games and creative discussions.",
            63,
            null,
            null,
            0)
    };

    private void OpenChannel(MyChannelListItemDto channel)
    {
        NavigationManager.NavigateTo($"/channels/{channel.Slug}");
    }

    private static string GetInitials(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return "?";

        var parts = value.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length == 1
            ? parts[0][0].ToString().ToUpper()
            : $"{char.ToUpper(parts[0][0])}{char.ToUpper(parts[1][0])}";
    }

    private static string FormatTime(DateTimeOffset? value)
    {
        if (value is null)
            return string.Empty;

        var now = DateTimeOffset.Now;
        var date = value.Value;

        if (date.Date == now.Date)
            return date.ToString("hh:mm tt");

        if (date.Date == now.AddDays(-1).Date)
            return "Yesterday";

        return date.ToString("dd/MM/yyyy");
    }

    public sealed record MyChannelListItemDto(
        int Id,
        Guid ChatId,
        string Slug,
        string Name,
        string Description,
        int ParticipantsCount,
        string? LastMessagePreview,
        DateTimeOffset? LastMessageAt,
        int UnreadCount
    );
}