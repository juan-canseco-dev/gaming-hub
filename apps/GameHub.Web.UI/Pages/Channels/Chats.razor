@page "/channels/{chatId:guid?}"
@attribute [Authorize]

@inject NavigationManager NavigationManager
@inject IChatService ChatService
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.False" Class="pa-0 full-height">
    <MudGrid Class="ma-0 full-height">

        <!-- MAIN CHAT -->
        <MudItem xs="12" md="9" Class="chat-layout">

            <!-- HEADER (STATIC) -->
            <MudPaper Elevation="0" Class="px-6 pt-0 pb-2 chat-header">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.h5" Class="fw-bold">
                            # @ChannelName
                        </MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            @ChannelDescription
                        </MudText>
                    </MudStack>

                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <MudIcon Icon="@Icons.Material.Filled.Groups" Color="Color.Primary" />
                        <MudText Typo="Typo.body2">@ParticipantsCount members</MudText>
                    </MudStack>
                </MudStack>
            </MudPaper>

            <!-- SCROLLABLE MESSAGES -->
            <div class="message-container">
                <MudStack Spacing="3">
                    @foreach (var message in Messages)
                    {
                        <div class="@(message.IsMine ? "message-row mine" : "message-row")">
                            <MudAvatar Size="Size.Medium" Class="message-avatar">
                                @message.AuthorName.Substring(0, 1).ToUpper()
                            </MudAvatar>

                            <MudPaper Class="message-bubble" Elevation="0">
                                <MudStack Spacing="1">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                        <MudText Typo="Typo.subtitle2" Class="fw-bold">
                                            @message.AuthorName
                                        </MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                            @message.SentAt.ToString("hh:mm tt")
                                        </MudText>
                                    </MudStack>

                                    <MudText Typo="Typo.body2">
                                        @message.Content
                                    </MudText>
                                </MudStack>
                            </MudPaper>
                        </div>
                    }
                </MudStack>
            </div>

            <MudPaper Elevation="0" Class="chat-composer pa-4">
                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.End">
                    <MudTextField T="string"
                                  @bind-Value="_messageText"
                                  Placeholder="Write a message..."
                                  Variant="Variant.Outlined"
                                  Lines="2"
                                  FullWidth="true"
                                  Class="composer-input" />

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Send"
                               OnClick="SendMessage">
                        Send
                    </MudButton>
                </MudStack>
            </MudPaper>

        </MudItem>

        <!-- SIDEBAR -->
        <MudItem md="3" Class="members-sidebar d-none d-md-flex">
            <MudPaper Elevation="0" Class="members-panel pa-4">
                <MudText Typo="Typo.h6" Class="fw-bold mb-4">Members</MudText>

                <MudStack Spacing="3">
                    @foreach (var member in Members)
                    {
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudAvatar Size="Size.Small" Class="member-avatar">
                                @member.Substring(0, 1).ToUpper()
                            </MudAvatar>

                            <MudText Typo="Typo.body2">@member</MudText>
                        </MudStack>
                    }
                </MudStack>
            </MudPaper>
        </MudItem>

    </MudGrid>
</MudContainer>

<style>
    .full-height {
        height: 100vh;
    }

    .chat-layout {
        display: flex;
        flex-direction: column;
        height: 100vh;
        overflow: hidden;
    }

    .chat-header {
        flex-shrink: 0;
    }

    .message-container {
        flex: 1;
        overflow-y: auto;
        padding: 16px;
        padding-bottom: 200px;
    }

    .chat-composer {
        flex-shrink: 0;
        border-top: 1px solid #e0e0e0;
        background: white;
        position: fixed;
        bottom: 0;
        left: 300px;
        right: 0;
        z-index: 1100;
    }

    .message-row {
        display: flex;
        gap: 12px;
    }
    
    .message-row.mine {
        flex-direction: row-reverse;
    }

    .message-bubble {
        padding: 12px;
        max-width: 600px;
        border-radius: 12px;
        background-color: #f5f5f5;
    }

    .message-row.mine .message-bubble {
        background-color: #d1e7ff;
    }

    .members-sidebar {
        height: 100vh;
    }

    .members-panel {
        width: 100%;
    }
</style>

@code {
    [Parameter]
    public Guid ChatId { get; set; }
    private string ChannelName = "general-gaming";
    private string ChannelDescription = "Talk about what you're currently playing and gaming news.";
    private int ParticipantsCount = 128;

    private string _messageText = string.Empty;

    private List<string> Members = new()
    {
        "Juan Pablo",
        "Alex Carter",
        "Sarah Miles",
        "Daniel Torres",
        "Mia Johnson",
        "Chris Stone"
    };

    private List<ChatMessageVm> Messages = new()
    {
        new() { AuthorName = "Alex Carter", Content = "Anyone playing Helldivers 2 tonight?", SentAt = DateTime.Now.AddMinutes(-35), IsMine = false },
        new() { AuthorName = "Juan Pablo", Content = "Yes, I’ll be online later. Around 9 PM.", SentAt = DateTime.Now.AddMinutes(-30), IsMine = true },
        new() { AuthorName = "Sarah Miles", Content = "I’ve been playing retro games lately, but I might join.", SentAt = DateTime.Now.AddMinutes(-22), IsMine = false },
        new() { AuthorName = "Daniel Torres", Content = "We should make a squad and coordinate here.", SentAt = DateTime.Now.AddMinutes(-10), IsMine = false },
    };

    private void SendMessage()
    {
        if (string.IsNullOrWhiteSpace(_messageText))
            return;

        Messages.Add(new ChatMessageVm
        {
            AuthorName = "You",
            Content = _messageText.Trim(),
            SentAt = DateTime.Now,
            IsMine = true
        });

        _messageText = string.Empty;

        StateHasChanged();
    }

    public sealed class ChatMessageVm
    {
        public string AuthorName { get; set; } = string.Empty;
        public string Content { get; set; } = string.Empty;
        public DateTime SentAt { get; set; }
        public bool IsMine { get; set; }
    }
}