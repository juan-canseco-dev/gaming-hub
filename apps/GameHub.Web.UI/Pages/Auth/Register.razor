@page "/auth/register"
@inject ISnackbar Snackbar
@inject JwtAuthenticationStateProvider AuthProvider
@inject NavigationManager NavManager
@inject IAuthService AuthService
@attribute [AllowAnonymous]

<PageTitle>Register</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-5">
    <MudPaper Elevation="4" Class="p-4">
        <MudText Typo="Typo.h4" Class="mb-4">Register</MudText>
        <MudText Typo="Typo.subtitle2" Class="mb-4">Create a new account</MudText>
        
        <EditForm Model="@request" OnValidSubmit="@OnValidSubmit">
            
            <MudTextField Disabled="@IsLoading" @bind-Value="request.Fullname" Class="mt-4" Label="Fullname" Required="true" MaxLength="50" />
            <MudTextField Disabled="@IsLoading" @bind-Value="request.Username" Class="mt-4" Label="Username" Required="true" MaxLength="30" />
            <MudTextField Disabled="@IsLoading" @bind-Value="request.Email" Class="mt-4" Label="Email" Required="true" MaxLength="50" />
            <MudTextField Disabled="@IsLoading" @bind-Value="request.Password" class="mt-4" Label="Password" Required="true" MaxLength="30" />
            <MudTextField Disabled="@IsLoading" @bind-Value="request.ConfirmPassword" class="mt-4" Label="Confirm Password" Required="true" MaxLength="30" />


            @if (!IsLoading)
            {
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Class="mt-4" FullWidth="true">Sign Up</MudButton>
            }
            else
            {
                <MudButton Disabled="IsLoading" Variant="Variant.Filled" Color="Color.Primary" Class="mt-4" FullWidth="true">
                    <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                </MudButton>
            }

            <MudSpacer />

            <DataAnnotationsValidator />
            <ValidationSummary />

            <MudSpacer />
        </EditForm>

    </MudPaper>
</MudContainer>


@code {

    private RegisterUserRequest request = new ();

    private bool IsLoading { get; set; } = false;

    private async Task OnValidSubmit()
    {
        IsLoading = true;
        await Task.Delay(1500);
        var result = await AuthService.RegisterAsync(request);
        IsLoading = false;
        
        if (result.IsFailure)
        {
            var message = result.Error.Description;

            var severity = result.Error.Equals(Error.InternalServerError)
                ? Severity.Error
                : Severity.Warning;

            Snackbar.Clear();
            Snackbar.Add(message, severity);
            return;
        }

        NavManager.NavigateTo($"/auth/login/true");
    }

    protected override async Task OnInitializedAsync()
    {
        if (await AuthProvider.IsLoggedInAsync())
        {
            NavManager.NavigateTo("/chats");
        }
    }
}