@page "/auth/login/{userCreated:bool?}"

@inject ISnackbar Snackbar
@inject IAuthService AuthService
@inject JwtAuthenticationStateProvider AuthProvider
@inject NavigationManager NavManager
@attribute [AllowAnonymous]

@if (UserCreated)
{
    <MudAlert Severity="Severity.Success" Elevation="6" ShowCloseIcon="true" CloseIconClicked="() => CloseAlert()">
        Registration successful. Please sign in to continue.
    </MudAlert>
}

<PageTitle>Login</PageTitle>
<MudContainer MaxWidth="MaxWidth.Small" Class="mt-5">
    <MudPaper Elevation="4" Class="p-4">
        <MudText Typo="Typo.h4" Class="mb-4">Login</MudText>
        <MudText Typo="Typo.subtitle2" Class="mb-4">Sign In to your account</MudText>
        <EditForm Model="@request" OnValidSubmit="OnValidSubmit">

            <MudTextField @bind-Value="request.Email" Label="Email" Type="email" Required="true" Disabled="@IsLoading" />
            <MudTextField @bind-Value="request.Password" Label="Password" Type="password" Required="true" Disabled="@IsLoading" />

            @if (!IsLoading)
            {
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Class="mt-4" FullWidth="true">Login</MudButton>
            }
            else
            {
                <MudButton Disabled="IsLoading" Variant="Variant.Filled" Color="Color.Primary" Class="mt-4" FullWidth="true">
                    <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                </MudButton>
            }
            <MudSpacer />
            <MudSpacer />
            <ValidationSummary />
            <DataAnnotationsValidator />
            <MudSpacer />

        </EditForm>
    </MudPaper>
</MudContainer>

@code {

    [Parameter]
    public bool UserCreated { get; set; }

    private bool IsLoading { get; set; } = false;
    private GetTokenRequest request = new GetTokenRequest();

    private void CloseAlert()
    {
        UserCreated = false;
    }

    private async Task OnValidSubmit()
    {
        IsLoading = true;

        await Task.Delay(1500);
        var result = await AuthService.LoginAsync(request);

        string? message = string.Empty;

        IsLoading = false;

        if (result.IsFailure)
        {
            message = result.Error.Description;

            var severity = result.Error.Equals(Error.InternalServerError)
                ? Severity.Error
                : Severity.Warning;

            Snackbar.Clear();
            Snackbar.Add(message, severity);
            return;
        }

        var userDetails = result.Value;
        message = $"Welcome {userDetails.UserName}";
        Snackbar.Add(message, Severity.Success);
        NavManager.NavigateTo("/home");
    }
}