@using MudBlazor
@inherits LayoutComponentBase

<MudThemeProvider Theme="@_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<AuthorizeView>
    <NotAuthorized>
        <MudLayout>
            <MudAppBar Color="Color.Primary" Elevation="4">
                <MudLink Href="/" Underline="Underline.None" Color="Color.Inherit" Class="d-flex align-center ml-2">
                    <MudText Typo="Typo.h6">Gaming Hub</MudText>
                </MudLink>

                <MudSpacer />

                <MudButton Class="ml-auto" Color="Color.Inherit" Variant="Variant.Text" Href="/auth/register">
                    Sign Up
                </MudButton>

                <MudButton Color="Color.Inherit" Variant="Variant.Text" Href="/auth/login">
                    Sign In
                </MudButton>
            </MudAppBar>

            <MudMainContent>
                @Body
            </MudMainContent>
        </MudLayout>
    </NotAuthorized>

    <Authorized>
        <MudLayout Class="app-shell">
            <MainBody>
                @Body
            </MainBody>
        </MudLayout>
    </Authorized>
</AuthorizeView>

<style>
    .app-shell {
        height: 100vh;
        overflow: hidden;
    }
</style>