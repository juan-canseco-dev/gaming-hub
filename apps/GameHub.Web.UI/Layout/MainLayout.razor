﻿@using MudBlazor
@inherits LayoutComponentBase

<MudThemeProvider Theme="@_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<AuthorizeView>
    <NotAuthorized>
        <MudLayout>
            <MudAppBar Color="Color.Primary" Elevation="4">
                <MudText Typo="Typo.h6" Class="ml-2">Gaming Hub</MudText>
                <MudSpacer />
                <MudButton Class="ml-auto" Color="Color.Inherit" Variant="Variant.Text" Href="/auth/register">Sign Up</MudButton>
                <MudButton Color="Color.Inherit" Variant="Variant.Text" Href="/auth/login">Sign In</MudButton>
            </MudAppBar>
            <MudMainContent>
                @Body
            </MudMainContent>
        </MudLayout>
    </NotAuthorized>
    <Authorized>
        <MudLayout Class="d-flex flex-column" Style="height:100vh; overflow:hidden;">
            <MainBody>
                @Body
            </MainBody>
        </MudLayout>
    </Authorized>
</AuthorizeView>
